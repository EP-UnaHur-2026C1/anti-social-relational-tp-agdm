{
  "info": {
    "name": "Anti-Social AGDM",
    "_postman_id": "anti-social-net-2024",
    "description": "Colección completa de endpoints para la API de UnaHur Anti-Social Net",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Obtener todos los usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/users",
            "description": "Retorna nickName y email de todos los usuarios"
          }
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"juanito99\",\n  \"email\": \"juan@mail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "http://localhost:3000/users",
            "description": "Crea un nuevo usuario. nickName es PK y único. Email único. Password mín 6 caracteres."
          }
        },
        {
          "name": "Obtener usuario por nickName",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/users/juanito99",
            "description": "Retorna el usuario con sus listas Followers y Following"
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo_email@mail.com\",\n  \"password\": \"nuevaPassword123\"\n}"
            },
            "url": "http://localhost:3000/users/juanito99",
            "description": "Actualiza email y/o password. Se debe enviar al menos uno de los dos campos."
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:3000/users/juanito99",
            "description": "Elimina el usuario con el nickName especificado"
          }
        }
      ]
    },
    {
      "name": "Followers",
      "item": [
        {
          "name": "Seguir usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seguir\": \"maria_gomez\"\n}"
            },
            "url": "http://localhost:3000/users/juanito99/follow",
            "description": "juanito99 (en la URL) sigue a maria_gomez (en el body). No se puede seguir a uno mismo."
          }
        },
        {
          "name": "Dejar de seguir usuario",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seguir\": \"maria_gomez\"\n}"
            },
            "url": "http://localhost:3000/users/juanito99/unfollow",
            "description": "juanito99 deja de seguir a maria_gomez"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Obtener todos los posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/post",
            "description": "Retorna todos los posts con author, comments, images y tags"
          }
        },
        {
          "name": "Obtener post por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/post/1",
            "description": "Retorna un post específico con author, comments, images y tags"
          }
        },
        {
          "name": "Obtener posts por usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/post/user/juanito99",
            "description": "Retorna todos los posts del usuario ordenados por fecha DESC con images y tags"
          }
        },
        {
          "name": "Crear post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Este es mi primer post en Anti-Social Net!\",\n  \"tags\": [\"#tecnologia\", \"#unahur\"],\n  \"images\": [\"https://picsum.photos/400/300\"]\n}"
            },
            "url": "http://localhost:3000/post/users/juanito99",
            "description": "Crea un post para el usuario. Tags deben comenzar con #. Arrays pueden estar vacíos."
          }
        },
        {
          "name": "Crear post (sin imágenes ni tags)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Post solo con descripcion\",\n  \"tags\": [],\n  \"images\": []\n}"
            },
            "url": "http://localhost:3000/post/users/juanito99",
            "description": "Crea un post mínimo solo con description obligatoria"
          }
        },
        {
          "name": "Actualizar post",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Descripción actualizada\",\n  \"tags\": [\"#actualizado\"],\n  \"images\": [\"https://picsum.photos/400/300\"]\n}"
            },
            "url": "http://localhost:3000/post/1",
            "description": "Reemplaza description, tags e images. Las imágenes anteriores se eliminan."
          }
        },
        {
          "name": "Eliminar post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:3000/post/1",
            "description": "Elimina el post y todas sus imágenes asociadas"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Obtener comentarios de un post",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/comments/post/1",
            "description": "Retorna comentarios visibles del post filtrados por MESES_VISIBILIDAD del .env"
          }
        },
        {
          "name": "Crear comentario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contenido\": \"Excelente post!\",\n  \"postId\": 1,\n  \"userNickname\": \"maria_gomez\"\n}"
            },
            "url": "http://localhost:3000/comments",
            "description": "Crea un comentario. contenido máx 500 chars. Post y usuario deben existir."
          }
        },
        {
          "name": "Actualizar comentario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contenido\": \"Comentario editado\"\n}"
            },
            "url": "http://localhost:3000/comments/1",
            "description": "Actualiza el contenido de un comentario por su ID"
          }
        },
        {
          "name": "Eliminar comentario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:3000/comments/1",
            "description": "Elimina un comentario por su ID"
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Obtener todos los tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/tags",
            "description": "Retorna todos los tags registrados"
          }
        },
        {
          "name": "Obtener tags de un post",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/tags/post/1",
            "description": "Retorna los tags asociados a un post específico"
          }
        },
        {
          "name": "Eliminar tag",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:3000/tags/1",
            "description": "Elimina un tag por su ID"
          }
        }
      ]
    },
    {
      "name": "Images",
      "item": [
        {
          "name": "Obtener todas las imágenes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/image",
            "description": "Retorna todas las imágenes con id, url y postId"
          }
        },
        {
          "name": "Obtener imágenes de un post",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/image/post/1",
            "description": "Retorna todas las imágenes asociadas a un post específico"
          }
        },
        {
          "name": "Eliminar imagen",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:3000/image/1",
            "description": "Elimina una imagen por su ID"
          }
        }
      ]
    },
    {
      "name": "Flujo completo de prueba",
      "item": [
        {
          "name": "1. Crear usuario A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"usuarioA\",\n  \"email\": \"usuarioA@mail.com\",\n  \"password\": \"pass1234\"\n}"
            },
            "url": "http://localhost:3000/users"
          }
        },
        {
          "name": "2. Crear usuario B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"usuarioB\",\n  \"email\": \"usuarioB@mail.com\",\n  \"password\": \"pass1234\"\n}"
            },
            "url": "http://localhost:3000/users"
          }
        },
        {
          "name": "3. usuarioA sigue a usuarioB",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seguir\": \"usuarioB\"\n}"
            },
            "url": "http://localhost:3000/users/usuarioA/follow"
          }
        },
        {
          "name": "4. usuarioA crea un post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Mi primer post del flujo de prueba\",\n  \"tags\": [\"#prueba\", \"#demo\"],\n  \"images\": [\"https://picsum.photos/400/300\"]\n}"
            },
            "url": "http://localhost:3000/post/users/usuarioA"
          }
        },
        {
          "name": "5. usuarioB comenta el post (id=1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contenido\": \"Qué buen post usuarioA!\",\n  \"postId\": 1,\n  \"userNickname\": \"usuarioB\"\n}"
            },
            "url": "http://localhost:3000/comments"
          }
        },
        {
          "name": "6. Ver todos los posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/post"
          }
        },
        {
          "name": "7. Ver comentarios del post (id=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/comments/post/1"
          }
        },
        {
          "name": "8. Ver tags del post (id=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/tags/post/1"
          }
        },
        {
          "name": "9. Ver imágenes del post (id=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/image/post/1"
          }
        },
        {
          "name": "10. Ver todos los tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/tags"
          }
        }
      ]
    }
  ]
}
